# Copy this file to .env and fill in real values. .env is gitignored.

# --- LLM provider ---
OPENAI_API_KEY=sk-replace-me
OPENAI_MODEL_SUPERVISOR=gpt-4o-mini
OPENAI_MODEL_RCA=gpt-4o
OPENAI_MODEL_JUDGE=gpt-4o-mini

# --- Langfuse (self-hosted, local only) ---
LANGFUSE_HOST=http://localhost:54000
LANGFUSE_PUBLIC_KEY=pk-lf-demo-0000000000000000
LANGFUSE_SECRET_KEY=sk-lf-demo-0000000000000000

# LANGFUSE_INIT_* auto-provision the org/project/admin user on first boot.
LANGFUSE_INIT_ORG_ID=capstone-org
LANGFUSE_INIT_ORG_NAME=Capstone Org
LANGFUSE_INIT_PROJECT_ID=capstone-project
LANGFUSE_INIT_PROJECT_NAME=obs-incident-investigator
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-demo-0000000000000000
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-demo-0000000000000000
LANGFUSE_INIT_USER_EMAIL=admin@capstone.local
LANGFUSE_INIT_USER_NAME=Capstone Admin
LANGFUSE_INIT_USER_PASSWORD=ChangeMe123!
LANGFUSE_INIT_USER_ROLE=ADMIN

# Generate real random values before first run, e.g. in Git Bash:
#   openssl rand -hex 32
LANGFUSE_SALT=changeme-salt-generate-with-openssl
LANGFUSE_ENCRYPTION_KEY=changeme-64-char-hex-generate-with-openssl
LANGFUSE_NEXTAUTH_SECRET=changeme-nextauth-secret-generate-with-openssl

# --- Backing services for Langfuse (local only, safe defaults) ---
LANGFUSE_DB_PASSWORD=langfuse
CLICKHOUSE_PASSWORD=langfuse
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=miniosecret123

# --- Demo / eval ---
AGENT_VERSION=v1-baseline

# --- Fixed service URLs (match docs/ports.md) ---
PROMETHEUS_URL=http://localhost:59090
LOKI_URL=http://localhost:53100
TEMPO_URL=http://localhost:53201
INCIDENT_CONTROLLER_URL=http://localhost:58006
